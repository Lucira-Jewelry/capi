# Everything the collector reads from its environment. Copy to .env for local use; on a server set these as managed
# secrets / environment variables. Never commit real values.

# ---- required ----
# 32 random bytes, base64. Encrypts ad-account tokens at rest. Keep it STABLE across deployments: a new key makes every
# saved token unreadable (brands would have to reconnect).   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SECRETS_KEY=
# Operator login for /admin.
ADMIN_TOKEN=
# Firestore. For a real project set the project and leave FIRESTORE_EMULATOR_HOST unset.
GOOGLE_CLOUD_PROJECT=
# Production must use an explicit database ID; use a separate database for staging in a shared GCP project.
FIRESTORE_DATABASE=
# FIRESTORE_EMULATOR_HOST=localhost:8080     (local development only)

# ---- sending (off by default) ----
# Nothing is sent to Meta or Google unless this is "on". It holds for the scheduler and the "Send waiting sales now" button.
OUTBOUND_SENDS=off
# Optional limits while testing: only these brands, only these platforms (meta, google_ads).
# SEND_ALLOWED_TENANTS=
# SEND_ALLOWED_DESTINATIONS=meta

# ---- public address ----
# The HTTPS address brands' tracking names point at (used for the DNS instructions and the script tag).
PUBLIC_URL=https://collector.example.com
PORT=8787

# ---- scheduler ----
# Lets Cloud Scheduler call POST /internal/dispatch (header x-internal-token). Leave empty to disable the endpoint.
INTERNAL_TOKEN=
# Local development only: send every N seconds from inside the process. Leave unset in production.
# DISPATCH_INTERVAL_SECONDS=30

# ---- Google (for sending conversions) ----
# Recommended: a service account key (the JSON text, or a path to the file).
GOOGLE_SERVICE_ACCOUNT_JSON=
# GOOGLE_SERVICE_ACCOUNT_FILE=
# Optional: OAuth client for brands that connect with a Google login.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ---- optional ----
# Signs the first-party cookie. Defaults to a value derived from SECRETS_KEY.
# COOKIE_SECRET=
