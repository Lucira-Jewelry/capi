rules_version = '2';

// All access to this database goes through our servers (Cloud Run / sGTM) using service-account IAM,
// which bypasses these rules. Browsers and mobile clients must never read or write it directly.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
