rules_version = '2';
// Only the collector reads and writes Firestore, through its service account (which is not subject to these rules).
// Nothing in a browser or mobile app should ever reach the database directly, so everything is refused.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
